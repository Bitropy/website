---
import { Icon } from "astro-icon/components";

const features = [
  {
    icon: "bx:bxs-key",
    title: "Central auth & keys",
    body: "Rotate provider keys in one place. Issue per-team or per-app tokens with scopes and revocation.",
  },
  {
    icon: "bx:bx-shuffle",
    title: "Smart routing & fallbacks",
    body: "Define model aliases, failover chains, and A/B splits as config — not code. Swap providers without redeploying.",
  },
  {
    icon: "bx:bxs-bar-chart-alt-2",
    title: "Live usage & cost tracking",
    body: "Per-user, per-app, per-team token and dollar metrics. Export to your BI tool or attribute spend to cost centers.",
  },
  {
    icon: "bx:bxs-lock",
    title: "Policy enforcement",
    body: "Redact PII, block categories, enforce data residency and retention. Every prompt passes through your rules first.",
  },
  {
    icon: "bx:bx-loader-circle",
    title: "Caching & rate limits",
    body: "Exact-match response cache and per-key throttling cut latency and bills on repeated calls without app changes.",
  },
  {
    icon: "bx:bxs-file-doc",
    title: "Audit logs & tracing",
    body: "Every request, response, and tool call is logged with correlation IDs. Debug an agent run the way you debug an HTTP service.",
  },
  {
    icon: "bx:bxs-plug",
    title: "OpenAI-compatible API",
    body: "Keep the SDK you already use. Point the base URL at Bitropy and everything continues to work.",
  },
  {
    icon: "bx:bxs-server",
    title: "Self-host or managed",
    body: "Deploy in your VPC for full data sovereignty, or let us run it. Single binary, no vendor database required.",
  },
  {
    icon: "bx:bx-transfer",
    title: "MCP gateway (included)",
    body: "Route and govern Model Context Protocol servers alongside LLM calls. One policy, auth, and audit layer for both.",
  },
];
---

<section class="mt-24 md:mt-32">
  <div class="text-center max-w-3xl mx-auto">
    <h2 class="text-4xl lg:text-5xl font-bold tracking-tight">
      Bitropy features
    </h2>
    <p class="text-lg mt-4 text-slate-600">
      Everything teams need to decouple LLM providers from their apps, govern traffic centrally, and track usage with less operational overhead.
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
    {features.map((f) => (
      <div class="bg-white border border-slate-200 rounded-xl p-6 hover:shadow-md hover:border-[#967deb] transition-all">
        <div class="bg-[#967deb]/10 rounded-lg w-11 h-11 flex items-center justify-center mb-4">
          <Icon class="text-[#967deb] w-6 h-6" name={f.icon} />
        </div>
        <h3 class="font-bold text-lg mb-2 text-slate-900">{f.title}</h3>
        <p class="text-slate-600 leading-relaxed text-sm">{f.body}</p>
      </div>
    ))}
  </div>
</section>
