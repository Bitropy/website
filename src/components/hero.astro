---
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
import HeroDiagram from "@/components/hero-diagram.astro";
---

<div class="absolute top-0 right-0 w-full h-[900px] md:h-[1100px] pointer-events-none -z-10" style="mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);">
  <div id="grain-gradient-container" class="w-full h-full"></div>
</div>

<main class="pt-10 pb-10 md:pt-20 md:pb-16 relative text-center">
  <div class="relative z-10 max-w-4xl mx-auto">
    <h1 class="text-4xl lg:text-6xl xl:text-7xl font-bold tracking-tight" style="text-shadow: 0 0 20px rgba(255, 255, 255, 0.8), 0 0 40px rgba(255, 255, 255, 0.6);">
      The enterprise
      <span class="relative inline-block align-baseline">
        <span
          class="rounded px-1"
          style="background: linear-gradient(90deg, #967deb33, #967deb1A)">
          LLM gateway
        </span>
        <svg
          aria-hidden="true"
          class="pointer-events-none absolute left-0 -bottom-1 w-full h-[10px] text-[#967deb]/70"
          viewBox="0 0 100 10"
          preserveAspectRatio="none">
          <path
            d="M2 8 C 20 2, 40 12, 58 6 S 90 2, 98 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"></path>
        </svg>
      </span>
      <br />
      for tracking, routing,
      <br />
      and governing AI usage.
    </h1>
    <p class="text-lg md:text-xl mt-8 text-slate-700 max-w-2xl mx-auto" style="text-shadow: 0 0 15px rgba(255, 255, 255, 0.9);">
      Bitropy sits between your apps and every LLM provider. One
      OpenAI-compatible endpoint, central auth, live usage tracking,
      policy controls, and model routing — without rewriting your code.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center">
      <Link href="/contact" class="flex gap-1 items-center justify-center">
        <Icon class="text-white w-5 h-5" name="bx:bxs-paper-plane" />
        Get Started
      </Link>
      <Link
        size="lg"
        style="outline"
        href="/contact"
        class="flex gap-2 items-center justify-center">
        <Icon class="text-black w-4 h-4" name="bx:bxs-phone" />
        Talk to Us
      </Link>
      <Link
        size="lg"
        style="outline"
        href="/products"
        class="flex gap-2 items-center justify-center">
        <Icon class="text-black w-4 h-4" name="bx:bxs-info-circle" />
        Learn More
      </Link>
    </div>
  </div>

  <div class="mt-16 md:mt-20 relative z-10">
    <HeroDiagram />
  </div>

  <div class="mt-10 flex items-center justify-center gap-2 text-sm tracking-widest uppercase">
    <span class="text-slate-500">Deploy in</span>
    <span class="text-[#10b981] font-semibold">under 10 minutes</span>
  </div>
</main>

<script>
  import {
    ShaderMount,
    grainGradientFragmentShader,
    getShaderNoiseTexture
  } from "@paper-design/shaders";

  function initShader() {
    const container = document.getElementById('grain-gradient-container');

    if (!container) {
      return;
    }

    if (container.querySelector('canvas')) {
      return;
    }

    const noiseTexture = getShaderNoiseTexture();

    if (!noiseTexture) {
      return;
    }

    const createShader = () => {
      new ShaderMount(
        container,
        grainGradientFragmentShader,
        {
          u_colorsCount: 3,
          u_colors: [
            [0.545, 0.361, 0.965, 1],
            [0.655, 0.545, 0.980, 1],
            [0.988, 0.827, 0.302, 1],
          ],
          u_softness: 0.8,
          u_intensity: 0.2,
          u_noise: 0,
          u_shape: 6,
          u_scale: 1.25,
          u_rotation: 180,
          u_offsetX: 0.5,
          u_offsetY: -0.1,
          u_noiseTexture: noiseTexture,
        },
        undefined,
        1
      );
    };

    noiseTexture.onload = createShader;
    if (noiseTexture.complete) {
      createShader();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShader);
  } else {
    initShader();
  }

  document.addEventListener('astro:page-load', initShader);
</script>
