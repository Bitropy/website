---
import { Icon } from "astro-icon/components";

const apps = [
  { label: "Python SDK", sub: "openai.Client()" },
  { label: "TypeScript SDK", sub: "new OpenAI()" },
  { label: "curl / HTTP", sub: "POST /v1/chat" },
];

const providers = [
  "OpenAI",
  "Anthropic",
  "Google",
  "Mistral",
  "Azure",
  "Ollama",
];

const capabilities = [
  "Aliases · Audit · Usage",
  "Routing · Cache · Policies",
];
---

<section class="mt-24 md:mt-32">
  <div class="text-center max-w-3xl mx-auto">
    <h2 class="text-4xl lg:text-5xl font-bold tracking-tight text-slate-400">
      How Bitropy works
    </h2>
    <p class="text-lg mt-4 text-slate-600">
      Bitropy authenticates every request, resolves model aliases, applies scoped policies, and routes traffic across providers through one OpenAI-compatible endpoint.
    </p>
  </div>

  <div class="mt-16 grid md:grid-cols-5 gap-4 md:gap-8 items-center max-w-6xl mx-auto">

    <div class="md:col-span-1">
      <div class="text-xs uppercase tracking-widest text-slate-400 mb-3 text-center md:text-left">Your Apps</div>
      <div class="flex flex-col gap-3">
        {apps.map((a) => (
          <div class="bg-white border border-slate-200 rounded-lg p-3">
            <div class="text-sm font-semibold text-slate-800">{a.label}</div>
            <div class="text-xs font-mono text-slate-500 mt-0.5">{a.sub}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="md:col-span-3">
      <div class="bg-slate-50 border-2 border-slate-200 rounded-2xl p-6 md:p-10">
        <div class="text-center font-bold text-2xl md:text-3xl mb-6 text-slate-900">Bitropy</div>
        <div class="flex justify-center gap-2 md:gap-3 mb-5 flex-wrap">
          <span class="bg-slate-200 text-slate-800 px-3 md:px-4 py-1.5 rounded text-sm font-medium">Auth</span>
          <Icon class="text-slate-400 w-4 h-4 self-center" name="bx:bx-right-arrow-alt" />
          <span class="bg-slate-200 text-slate-800 px-3 md:px-4 py-1.5 rounded text-sm font-medium">Plan</span>
          <Icon class="text-slate-400 w-4 h-4 self-center" name="bx:bx-right-arrow-alt" />
          <span class="bg-slate-200 text-slate-800 px-3 md:px-4 py-1.5 rounded text-sm font-medium">Provider</span>
        </div>
        <div class="flex flex-col gap-2 items-center">
          {capabilities.map((c) => (
            <div class="bg-[#967deb]/10 text-[#967deb] px-4 py-1.5 rounded-full text-sm font-medium">{c}</div>
          ))}
        </div>
      </div>
    </div>

    <div class="md:col-span-1">
      <div class="text-xs uppercase tracking-widest text-slate-400 mb-3 text-center md:text-left">AI Providers</div>
      <div class="flex flex-col gap-2">
        {providers.map((p) => (
          <div class="bg-white border-2 border-[#967deb] rounded-full px-4 py-2 text-sm font-medium text-slate-800 text-center">
            {p}
          </div>
        ))}
      </div>
    </div>

  </div>

  <div class="mt-12 text-center">
    <div class="inline-block bg-slate-900 text-white font-mono text-sm md:text-base px-4 py-2 rounded">
      POST https://gateway.bitropy.io/v1/chat/completions
    </div>
    <p class="text-slate-600 text-sm mt-3">
      Same OpenAI-compatible entry point. Change the base URL, keep your SDK.
    </p>
  </div>
</section>
