---
import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque/index.css";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  footerMargin?: boolean;
}

const DEFAULT_TITLE = "Bitropy — The Missing Control Layer for Enterprise AI";
const DEFAULT_DESCRIPTION = "Bitropy is the missing control layer for enterprise AI. Gain full visibility into AI usage across teams, models and data and enforce security, cost and compliance in real time. One endpoint. Full control. No rewrite required.";
const OG_IMAGE_ALT = "Bitropy — The Missing Control Layer for Enterprise AI.";

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const resolvedImageWithDomain = new URL(
  "/opengraph.png",
  Astro.site
).toString();

const { title, description, footerMargin = true } = Astro.props;

const makeTitle = title ? `${title} | Bitropy` : DEFAULT_TITLE;
const pageDescription = description ?? DEFAULT_DESCRIPTION;
const ogTitle = title ? `${title} | Bitropy` : DEFAULT_TITLE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={makeTitle}
      description={pageDescription}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: ogTitle,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: OG_IMAGE_ALT,
        },
      }}
      twitter={{
        card: "summary_large_image",
        site: "@bitropy",
        title: ogTitle,
        description: pageDescription,
        image: resolvedImageWithDomain,
      }}
    />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
      /* Remove arrows from list-style - fix for tailwindcss */
      details > summary.list-none::-webkit-details-marker,
      details > summary.list-none::marker {
        display: none;
      }
    </style>
    <ClientRouter />
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer margin={footerMargin} />
  </body>
</html>
