---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Cta from "@/components/cta.astro";
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "AI Runtime Control",
    subtitle: "Control AI where decisions actually happen.",
    description: "Bitropy enforces policies, permissions, and execution rules in real time across models, agents, prompts, and MCP workflows.",
    icon: "bx:bxs-bolt-circle",
  },
  {
    title: "Full AI Observability",
    subtitle: "See how AI really operates inside your company.",
    description: "Track prompts, model calls, tool usage, agents, costs, and data flows across every AI interaction and environment.",
    icon: "bx:bxs-show",
  },
  {
    title: "Secure MCP Infrastructure",
    subtitle: "Make AI-to-system access safe by design.",
    description: "Bitropy secures MCP servers, APIs, internal tools, and enterprise systems with runtime isolation, access boundaries, and auditability.",
    icon: "bx:bxs-shield-alt-2",
  },
  {
    title: "Enterprise AI Governance",
    subtitle: "Governance that actually runs in production.",
    description: "Move beyond policies in documents. Bitropy continuously enforces AI governance rules across teams, tools, and workflows.",
    icon: "bx:bxs-buildings",
  },
  {
    title: "AI FinOps & Cost Visibility",
    subtitle: "Know where AI spend comes from.",
    description: "Monitor usage and costs across teams, models, applications, and agents with anomaly detection and allocation insights.",
    icon: "bx:bxs-dollar-circle",
  },
  {
    title: "AI Agent Security",
    subtitle: "AI agents should not operate without boundaries.",
    description: "Prevent unsafe actions, unauthorized tool access, sensitive data exposure, and uncontrolled automation in production environments.",
    icon: "bx:bxs-lock-alt",
  },
  {
    title: "Sovereign AI Deployment",
    subtitle: "Run AI on your terms.",
    description: "Deploy fully on-premise or inside your VPC with complete control over infrastructure, models, data residency, and compliance.",
    icon: "bx:bxs-server",
  },
  {
    title: "Multi-Model Orchestration",
    subtitle: "One layer across every model.",
    description: "Route, govern, and monitor OpenAI, Anthropic, Gemini, local models, and custom deployments through a unified enterprise layer.",
    icon: "bx:bxs-network-chart",
  },
  {
    title: "Continuous Compliance",
    subtitle: "Compliance shouldn't happen once a year.",
    description: "Bitropy continuously maps AI activity to internal policies and regulatory frameworks including GDPR, EU AI Act, DORA, and NIS2.",
    icon: "bx:bxs-check-shield",
  },
];
---

<Layout
  title="Platform"
  description="Bitropy Platform — full control over enterprise AI. One layer to manage AI systems safely at scale: runtime control, observability, secure MCP, AI FinOps, agent security, sovereign deployment, multi-model orchestration and continuous compliance.">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Bitropy Platform</Fragment>
      <Fragment slot="desc">Full Control Over Enterprise AI</Fragment>
    </Sectionhead>

    <div class="mx-auto max-w-4xl mt-12">
      <p class="text-xl text-center text-slate-600 leading-relaxed">
        Bitropy gives organizations one layer to manage AI systems safely at scale — controlling access, monitoring usage, enforcing policies, and protecting sensitive data in real time.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mt-16">
      {
        features.map((feature) => (
          <div class="bg-slate-50 rounded-xl p-6">
            <div class="flex gap-3 items-center mb-4">
              <div class="bg-black rounded-full p-2 w-10 h-10 shrink-0 flex items-center justify-center">
                <Icon class="text-white w-5 h-5" name={feature.icon} />
              </div>
              <h3 class="font-bold text-lg">{feature.title}</h3>
            </div>
            <p class="text-purple-600 font-medium mb-2">{feature.subtitle}</p>
            <p class="text-slate-600 leading-relaxed">{feature.description}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-16 text-center">
      <p class="text-2xl font-bold text-gray-800">
        Run AI in production with confidence.
      </p>
    </div>

    <Cta />
  </Container>
</Layout>
