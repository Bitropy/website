---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import HowItWorks from "@/components/how-it-works.astro";
import ContactCards from "@/components/contact-cards.astro";
import { Icon } from "astro-icon/components";

const core = [
  {
    title: "LLM gateway",
    tag: "Core",
    description:
      "A single OpenAI-compatible endpoint in front of every provider. Central auth, routing, caching, policy, audit, and usage tracking — without SDK rewrites.",
    icon: "bx:bxs-network-chart",
  },
  {
    title: "Usage & cost tracking",
    tag: "Core",
    description:
      "Tokens, latency, and dollar spend attributed to users, apps, and teams. Export to Prometheus, BigQuery, or your BI tool.",
    icon: "bx:bxs-bar-chart-alt-2",
  },
  {
    title: "Policy enforcement",
    tag: "Core",
    description:
      "PII redaction, content filters, data residency, retention rules, and rate limits. Every request passes your policies before leaving the gateway.",
    icon: "bx:bxs-shield",
  },
  {
    title: "Routing, aliases & caching",
    tag: "Core",
    description:
      "Model aliases, failover chains, A/B splits, and exact-match caching — as config, not code. Swap providers without redeploying apps.",
    icon: "bx:bx-shuffle",
  },
  {
    title: "Audit & tracing",
    tag: "Core",
    description:
      "Full request / response trail with correlation IDs across services. Debug agent runs the way you debug HTTP services.",
    icon: "bx:bxs-file-doc",
  },
  {
    title: "Self-host or managed",
    tag: "Core",
    description:
      "Run Bitropy in your VPC (Docker, Kubernetes, single binary) or let us operate it for you. No required vendor database.",
    icon: "bx:bxs-server",
  },
];

const also = [
  {
    title: "MCP gateway",
    description:
      "Route and govern Model Context Protocol traffic through the same auth, audit, and policy layer as LLM calls. Central registry of MCP servers with per-tool isolation.",
    icon: "bx:bx-transfer",
  },
  {
    title: "AI risk intelligence",
    description:
      "Continuous analysis of AI activity to surface anomalies, policy drift, and vendor risks — mapped to your AI attack surface.",
    icon: "bx:bxs-error",
  },
  {
    title: "Continuous compliance",
    description:
      "AI usage mapped to EU AI Act, GDPR, SOC 2, ISO 27001, ISO/IEC 42000, and DORA controls. Audit evidence generated continuously, not once a year.",
    icon: "bx:bxs-check-shield",
  },
];
---

<Layout title="Products — Bitropy">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Bitropy platform</Fragment>
      <Fragment slot="desc">The enterprise LLM gateway, with MCP and governance built in.</Fragment>
    </Sectionhead>

    <div class="mx-auto max-w-3xl mt-12">
      <p class="text-xl text-center text-slate-600 leading-relaxed">
        One gateway for every model, every team, and every policy. Bitropy decouples LLM providers from your apps, tracks every request, and enforces security and compliance centrally.
      </p>
    </div>

    <div class="mt-16">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-xs font-semibold uppercase tracking-widest text-[#967deb]">Core</span>
        <span class="h-px flex-1 bg-slate-200"></span>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {core.map((f) => (
          <div class="bg-white border border-slate-200 rounded-xl p-6 hover:border-[#967deb] transition-colors">
            <div class="bg-[#967deb]/10 rounded-lg w-11 h-11 flex items-center justify-center mb-4">
              <Icon class="text-[#967deb] w-6 h-6" name={f.icon} />
            </div>
            <h3 class="font-bold text-lg text-slate-900">{f.title}</h3>
            <p class="text-slate-600 leading-relaxed text-sm mt-2">{f.description}</p>
          </div>
        ))}
      </div>
    </div>

    <HowItWorks />

    <div class="mt-24">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-xs font-semibold uppercase tracking-widest text-slate-500">Also included</span>
        <span class="h-px flex-1 bg-slate-200"></span>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {also.map((f) => (
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
            <div class="bg-white rounded-lg w-11 h-11 flex items-center justify-center mb-4 border border-slate-200">
              <Icon class="text-slate-700 w-6 h-6" name={f.icon} />
            </div>
            <h3 class="font-bold text-lg text-slate-900">{f.title}</h3>
            <p class="text-slate-600 leading-relaxed text-sm mt-2">{f.description}</p>
          </div>
        ))}
      </div>
    </div>

    <ContactCards />
  </Container>
</Layout>
